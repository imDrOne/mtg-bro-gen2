#!/usr/bin/env bash
# Enforce Conventional Commits on the subject line: type(scope)!: description.
# See CLAUDE.md#commit-messages for the type list and rationale. Applies to
# ANY committer (human or agent) once `core.hooksPath` points here — see
# scripts/setup-local.sh. Merge/fixup/squash commits (git/rebase generated)
# and `git revert`'s own default subject are exempt.
set -euo pipefail
msg_file="$1"
subject="$(head -n1 "$msg_file")"

case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*)
    exit 0
    ;;
esac

# type(scope)!: description — scope and ! are optional.
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9/_.-]+\))?!?: .+'

if [[ "$subject" =~ $pattern ]]; then
  exit 0
fi

cat >&2 <<EOF
commit-msg: subject must follow Conventional Commits:
  <type>(<scope>)!: <description>
scope and ! (breaking change) are optional. Got: '$subject'

  feat     new feature              fix      bug fix
  docs     documentation only       style    formatting, no code change
  refactor code change, no feat/fix perf     performance improvement
  test     adding/fixing tests      build    build system / deps
  ci       CI config                chore    everything else (tooling, config)
  revert   revert a previous commit

Examples:
  feat(deck): add outbox relay for deck.saved
  fix: nil pointer in card search
  feat(auth)!: require PKCE on the authorization_code flow

Full list + rationale: CLAUDE.md#commit-messages
Emergency bypass (ask yourself why first): git commit --no-verify
EOF
exit 1
